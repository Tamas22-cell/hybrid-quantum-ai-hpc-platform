{
  "title": "Hybrid HPC API",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "targets": [
        {
          "expr": "sum(rate(hpc_http_requests_total[5m]))"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P95 request latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hpc_http_duration_seconds_bucket[5m])) by (le))"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    }
  ]
}